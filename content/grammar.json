  {"id":"gram-002","pattern":"〜てしまう","meaning":"〜完了；〜不小心","explanation":"表示动作完成或遗憾的心情。","examples":["本を読んでしまった。","財布を忘れてしまった。"],"related":["〜ておく"],"source":"bundled"},
  {"id":"gram-003","pattern":"〜てもいい","meaning":"可以〜","explanation":"表示许可。","examples":["ここに座ってもいいです。","質問してもいいですか。"],"related":["〜てはいけない"],"source":"bundled"},
  {"id":"gram-004","pattern":"〜てはいけない","meaning":"不可以〜","explanation":"表示禁止。","examples":["ここで遊んではいけない。","遅刻してはいけない。"],"related":["〜てもいい"],"source":"bundled"},
