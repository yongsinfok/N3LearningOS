  {"id":"gram-006","pattern":"〜たことがある","meaning":"曾经〜过","explanation":"表示过去的经验。","examples":["富士山に登ったことがある。","すしを食べたことがある。"],"source":"bundled"},
  {"id":"gram-007","pattern":"〜ことができる","meaning":"能〜，会〜","explanation":"表示能力或可能。","examples":["日本語を話すことができる。","一人で行くことができる。"],"related":["〜られる"],"source":"bundled"},
  {"id":"gram-008","pattern":"〜やすい／〜にくい","meaning":"容易〜／难〜","explanation":"表示动作的难易程度。","examples":["この本は読みやすい。","このペンは書きにくい。"],"source":"bundled"},
  {"id":"gram-009","pattern":"〜そうだ（様態）","meaning":"好像〜","explanation":"表示从外观判断。","examples":["雨が降りそうだ。","おいしそうなケーキ。"],"related":["〜ようだ","〜らしい"],"source":"bundled"},
  {"id":"gram-010","pattern":"〜ようだ／〜みたいだ","meaning":"好像〜","explanation":"表示主观推测、比喻。","examples":["風邪のようだ。","子供みたいな人だ。"],"related":["〜そうだ","〜らしい"],"source":"bundled"},
  {"id":"gram-011","pattern":"〜らしい","meaning":"像是〜；据说〜","explanation":"表示有客观依据的推测或传闻。","examples":["彼は日本人らしい。","天気はいいらしい。"],"related":["〜そうだ","〜ようだ"],"source":"bundled"},
  {"id":"gram-012","pattern":"〜ために（目的）","meaning":"为了〜","explanation":"表示目的。","examples":["日本語を勉強するために、学校に行く。","試験に合格するために頑張る。"],"source":"bundled"},
